{
  "name": "auto-codex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build:server",
    "dev": "concurrently -k -n compile,bridge,web -c yellow,magenta,cyan \"npm:dev:compile\" \"npm:dev:bridge\" \"npm:dev:web\"",
    "dev:compile": "tsc -p tsconfig.server-build.json --watch --preserveWatchOutput",
    "dev:bridge": "node --watch build-server/server/index.js",
    "dev:web": "vite --host 127.0.0.1 --port 4780",
    "assets:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\tools\\build-generated-pixel-assets.ps1",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "build:server": "tsc -p tsconfig.server-build.json",
    "build": "npm run typecheck && vite build && npm run build:server",
    "start": "node build-server/server/index.js --serve",
    "launch": "npm run build && node build-server/server/index.js --serve --open"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
